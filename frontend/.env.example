# Copy to .env.local and fill in real values for anything beyond local dev.
# Never commit a real .env.local file (already gitignored at the repo root).

# --- Backend base URL ------------------------------------------------------
API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Auth (Sprint 09) --------------------------------------------------
# The Origin a real browser on this app sends. The backend's CSRF/Origin
# check middleware requires this on cookie-bearing state-changing requests
# (login/logout/change-password) and it must match an entry in the
# backend's CORS_ORIGINS. Server-only; never expose as NEXT_PUBLIC_*.
APP_ORIGIN=http://localhost:3000

# Server-only service credentials forwarded by backendFetch as X-API-Key,
# selected by the current session's role (Sprint 09 §7 "API-key exchange").
# Currently inert for read endpoints -- see Sprint 09 §11 Phase 5 -- but
# wired now so Phase 5's backend cutover needs no frontend change. Must
# match the values the backend (services/api, see the repo-root
# .env/.env.example) is configured with. Never prefix with NEXT_PUBLIC_ --
# these must never reach the browser bundle.
ADMIN_API_KEY=dev-admin-key-do-not-use-in-production
VIEWER_API_KEY=dev-viewer-key-do-not-use-in-production
