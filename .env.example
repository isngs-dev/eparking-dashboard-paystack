# Copy to .env and fill in real values for anything beyond local dev.
# Never commit a real .env file.

APP_ENV=development

# --- Postgres ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=eparking
POSTGRES_USER=eparking
POSTGRES_PASSWORD=eparking_dev_password

# --- Redis -----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Paystack --------------------------------------------------------------
# Placeholder only. Never commit a real Paystack secret key.
PAYSTACK_SECRET_KEY=sk_test_placeholder_replace_me

# --- Security ----------------------------------------------------------
# Dev-safe defaults below. Production MUST override both with strong,
# distinct, >=32-character random values -- startup validation rejects the
# defaults, short values, and JWT_SECRET == SECRET_ENCRYPTION_KEY.
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production
SECRET_ENCRYPTION_KEY=dev-only-encryption-key-do-not-use-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- Auth (Sprint 7, repositioned as service credentials by Sprint 9) ----
# Two static per-role API keys, presented via the 'X-API-Key' header.
# Production MUST override both with strong, distinct, random values --
# startup validation rejects the dev defaults and ADMIN_API_KEY == VIEWER_API_KEY.
# As of Sprint 09 Phase 4, the Next.js frontend also holds its own copies of
# these two values (see frontend/.env.example) to attach as X-API-Key on
# server-to-server backendFetch calls -- keep both sides' values in sync.
ADMIN_API_KEY=dev-admin-key-do-not-use-in-production
VIEWER_API_KEY=dev-viewer-key-do-not-use-in-production

# --- API -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Host-side port the API is published on (container always listens on 8000
# internally; this only changes what you hit from outside Docker).
API_HOST_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Celery (optional overrides; default to the Redis settings above) ----
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
